{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Mi Band Bridge",
        "width": 700,
        "height": 640,
        "resizable": true,
        "visible": true,
        "focus": false,
        "minWidth": 700,
        "maxWidth": 700,
        "decorations": false,
        "maximizable": false,
        "scrollBarStyle": "fluentOverlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "ctrl-alt-delete-8",
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
